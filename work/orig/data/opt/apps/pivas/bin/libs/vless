_vless_parse_url() {
    # Общий парсер CLI, веба и бота. Секрет не попадает в ошибки.
    if ! VLESS_PARSED_OUTBOUND=$(printf '%s' "$1" | /opt/bin/python3 /opt/apps/pivas/bin/main/vless_url.py prepare "${2:-$VLESS_CONFIG_FILE}" 2>&1); then
        _vless_invalid "$VLESS_PARSED_OUTBOUND"
        return 1
    fi
}


_vless_init_config_if_needed() {
#-------------------------------------------------------------------------------
#   Копируем шаблон только если живого конфига ещё нет: файла нет, это
#   старый однослотовый шаблон (@VLESS_*) или нет тегов slot-1/slot-2.
#   Оставшиеся @SLOT2_* НЕ повод затирать уже заполненный slot-1 —
#   их снимает _vless_ensure_placeholder_slots_mirrored.
#-------------------------------------------------------------------------------

    local _file="${1:-$VLESS_CONFIG_FILE}"
    local need_init=0

    if [ ! -f "$_file" ]; then
        need_init=1
    elif grep -qE '@VLESS_' "$_file"; then
        need_init=1
    elif ! jq -e '[.outbounds[].tag] | contains(["slot-1","slot-2"])' "$_file" >/dev/null 2>&1; then
        need_init=1
    fi

    if [ "$need_init" = "1" ]; then
        mkdir -p "$(dirname "$_file")" 2>/dev/null
        cp "$VLESS_CONFIG_ORIGINAL_FILE" "$_file" || {
            error "Не удалось создать $_file из шаблона $VLESS_CONFIG_ORIGINAL_FILE"
            return 1
        }
        # @VLESS_SSR_PORT в шаблоне обёрнут в кавычки, чтобы шаблон был
        # валидным JSON. Подставляем число, убирая обрамляющие кавычки.
        sed -i "s|\"@VLESS_SSR_PORT\"|${PROXY_VLESS_PORT}|g; s|@VLESS_SSR_PORT|${PROXY_VLESS_PORT}|g" "$_file"
    fi
    return 0
}


vless_link_parse() {
#-------------------------------------------------------------------------------
#   Парсит vless:// и записывает параметры в outbound указанного слота.
#   Вызов:  vless_link_parse <url> [config_file] [slot]
#   slot по умолчанию = 1 (обратная совместимость со старым вызовом).
#-------------------------------------------------------------------------------

    local link="$1"
    local _vless_file="${2:-$VLESS_CONFIG_FILE}"
    local slot="${3:-1}"
    case "$slot" in 1|2) ;; *) error "Некорректный номер слота: $slot (1 или 2)"; return 1 ;; esac

    _vless_parse_url "$link" "$_vless_file" || return 1
    _vless_init_config_if_needed "$_vless_file" || return 1

    local _tmp
    _tmp=$(mktemp) || { error "Не удалось создать временный файл"; return 1; }
    if ! printf '%s' "$VLESS_PARSED_OUTBOUND" | /opt/bin/python3 /opt/apps/pivas/bin/main/vless_url.py replace "$_vless_file" "$slot" > "$_tmp"; then
        error "Не удалось обновить VLESS-слот"
        rm -f "$_tmp"
        return 1
    fi

    mv "$_tmp" "$_vless_file"
    _vless_ensure_placeholder_slots_mirrored "$_vless_file"
    return 0
}


_vless_other_slot() {
    [ "$1" = "1" ] && echo 2 || echo 1
}


_vless_slot_is_placeholder() {
#-------------------------------------------------------------------------------
#   Проверяет, что указанный slot-N ещё не настроен: любое из
#   address/port/id/network начинается с @ или пусто.
#   Вызов: _vless_slot_is_placeholder <slot> [config_file]
#-------------------------------------------------------------------------------
    local slot="$1"
    local file="${2:-$VLESS_CONFIG_FILE}"
    ! /opt/bin/python3 /opt/apps/pivas/bin/main/vless_url.py configured "$file" "$slot" >/dev/null 2>&1
}


_vless_mirror_slot() {
#-------------------------------------------------------------------------------
#   Копирует outbound slot-$1 в slot-$2 (с сохранением тега $2).
#   Вызов: _vless_mirror_slot <from> <to> [config_file]
#-------------------------------------------------------------------------------
    local from="$1" to="$2"
    local file="${3:-$VLESS_CONFIG_FILE}"
    local _tmp
    _tmp=$(mktemp) || return 1
    jq --arg f "slot-${from}" --arg t "slot-${to}" '
        (.outbounds | map(select(.tag == $f))[0]) as $src
        | if $src == null then . else
            .outbounds |= map(
                if .tag == $t then ($src | .tag = $t) else . end
            )
          end
    ' "$file" > "$_tmp" && mv "$_tmp" "$file"
}


_vless_ensure_placeholder_slots_mirrored() {
#-------------------------------------------------------------------------------
#   Если один слот уже с реальной ссылкой, а второй ещё шаблон
#   (@SLOT2_NETWORK и т.п.) — клонируем заполненный в пустой.
#   Иначе xray падает: unknown transport protocol: @SLOT2_NETWORK.
#-------------------------------------------------------------------------------
    local file="${1:-$VLESS_CONFIG_FILE}"
    [ -f "$file" ] || return 0
    if _vless_slot_is_placeholder 1 "$file"; then
        _vless_slot_is_placeholder 2 "$file" || _vless_mirror_slot 2 1 "$file"
    elif _vless_slot_is_placeholder 2 "$file"; then
        _vless_mirror_slot 1 2 "$file"
    fi
}


_rotate_xray_logs() {
#-------------------------------------------------------------------------------
#   /tmp/log/* живёт в RAM на Keenetic. xray-access.log даже в idle растёт
#   ~1 КБ/мин → за сутки 1 МБ+, за неделю 10 МБ+ и мы теряем tmpfs. Обрезаем.
#-------------------------------------------------------------------------------
    local max_kb=5120
    for f in /tmp/log/xray-access.log /tmp/log/xray-errors.log; do
        [ -f "$f" ] || continue
        size=$(du -sk "$f" 2>/dev/null | awk '{print $1}')
        [ -z "$size" ] && continue
        if [ "$size" -gt "$max_kb" ]; then
            # Оставим последние ~1 МБ, остальное отсечём
            tail -c 1048576 "$f" > "${f}.new" && mv "${f}.new" "$f"
        fi
    done
}


_kill_xray_zombies() {
#-------------------------------------------------------------------------------
#   Defensive: убиваем ВСЕ процессы xray перед стартом нового.
#   Upstream S24xray restart может оставить «зомби» при ошибках init.d,
#   и после 10+ `vless set` накапливается по 100+ МБ RAM впустую.
#   Проверено: на Keenetic 6499 после N set'ов было N+1 процессов xray.
#-------------------------------------------------------------------------------
    local pids
    pids=$(pidof xray 2>/dev/null)
    [ -z "$pids" ] && return 0
    # Если только один — это нормальное состояние
    if [ "$(echo "$pids" | wc -w)" -gt 1 ]; then
        # Несколько процессов — зомби, убиваем ВСЕХ. init затем поднимет один.
        for pid in $pids; do
            kill -9 "$pid" 2>/dev/null
        done
        sleep 1
    fi
}


