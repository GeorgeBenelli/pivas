pivas_vless_set() {
#-------------------------------------------------------------------------------
#   Неинтерактивно применить vless-ссылку в выбранный слот.
#   Использование:  pivas_vless_set <slot> <vless://...>
#
#   Фичи:
#     * Per-slot бэкап — при set-1 сохраняется только slot-1 snapshot,
#       rollback-1 восстановит именно его. Так же для slot-2.
#     * Idempotent — если итоговый конфиг семантически идентичен текущему,
#       xray не рестартим (не дёргаем бот/клиентов).
#     * Зеркало — если другой слот не настроен, клонируем туда наш.
#-------------------------------------------------------------------------------

    local slot="$1"
    local url="$2"
    case "$slot" in 1|2) ;; *) error "Укажите слот 1 или 2"; return 1 ;; esac
    if [ -z "$url" ]; then
        echo "Использование: pivas vless set-${slot} <vless://...>"
        return 1
    fi
    case "$url" in
        vless://*|hysteria2://*|hy2://*) ;;
        *) _vless_invalid "поддерживаются vless://, hysteria2:// и hy2://"; return 1 ;;
    esac

    mkdir -p "$PIVAS_BACKUP_PATH" 2>/dev/null

    # Snapshot текущего состояния целевого слота — пригодится для rollback-N
    local _slot_bak
    case "$slot" in
        1) _slot_bak="$VLESS_BACKUP_SLOT1" ;;
        2) _slot_bak="$VLESS_BACKUP_SLOT2" ;;
    esac

    # Снапшот ВСЕГО конфига на случай фейла при обновлении (atomic rollback)
    local _rollback_guard=""
    if [ -f "$VLESS_CONFIG_FILE" ]; then
        _rollback_guard="${VLESS_CONFIG_FILE}.pre-set-${slot}.$$"
        cp "$VLESS_CONFIG_FILE" "$_rollback_guard"
    fi

    vless_link_parse "$url" "$VLESS_CONFIG_FILE" "$slot" || {
        [ -n "$_rollback_guard" ] && [ -f "$_rollback_guard" ] && mv "$_rollback_guard" "$VLESS_CONFIG_FILE"
        return 1
    }

    # Если другой слот ещё не задан — клонируем в него этот
    # (vless_link_parse уже зеркалит; повтор идемпотентен).
    _vless_ensure_placeholder_slots_mirrored "$VLESS_CONFIG_FILE"

    _vless_sync_slot2_routing || { [ -n "$_rollback_guard" ] && mv "$_rollback_guard" "$VLESS_CONFIG_FILE"; return 1; }

    # Валидация конфига xray
    local check
    check=$("${XRAY}" run -test -c "$VLESS_CONFIG_FILE" 2>&1)
    if ! echo "$check" | grep -q "Configuration OK"; then
        echo -e "${RED}Ошибки в конфигурации xray:${NOCL}"
        echo "$check"
        [ -n "$_rollback_guard" ] && [ -f "$_rollback_guard" ] && mv "$_rollback_guard" "$VLESS_CONFIG_FILE"
        return 1
    fi

    # Idempotent: если итог байт-в-байт по jq -S идентичен rollback-guard'у,
    # xray не рестартим — избегаем лишнего окна недоступности.
    local identical=no
    if [ -n "$_rollback_guard" ] && [ -f "$_rollback_guard" ]; then
        if diff -q "$(jq -S . "$_rollback_guard" > "${_rollback_guard}.s"; echo "${_rollback_guard}.s")" \
                    "$(jq -S . "$VLESS_CONFIG_FILE" > "${_rollback_guard}.n"; echo "${_rollback_guard}.n")" \
                    >/dev/null 2>&1; then
            identical=yes
        fi
        rm -f "${_rollback_guard}.s" "${_rollback_guard}.n"
    fi

    if [ "$identical" = "yes" ]; then
        rm -f "$_rollback_guard"
        echo "slot-${slot}: конфиг не изменился, xray не трогаем"
        return 0
    fi
    if [ -n "$_rollback_guard" ] && [ -f "$_rollback_guard" ]; then
        jq --arg tag "slot-${slot}" '{outbound: (.outbounds[] | select(.tag == $tag))}' "$_rollback_guard" > "$_slot_bak" || return 1
        mv "$_rollback_guard" "$VLESS_CONFIG_FILE_BACKUP" || return 1
    fi

    ready "Перезапускаем xray (slot-${slot})"
    _kill_xray_zombies
    _rotate_xray_logs
    if _vless_restart_xray >/dev/null 2>&1; then
        _ensure_t2s_route
        _vless_sync_dns_country || return 1
        when_ok "УСПЕШНО"
        # Смена outbound не требует ни рестарта DNS, ни flush ipset, ни
        # пересборки маршрутов: IP из PIVAS_LIST по-прежнему уходят в t2s21 ->
        # xray, а xray уже говорит с новым сервером. Только проверяем DNS.
        _vless_dns_selfcheck || true
    else
        when_bad "ОШИБКА"
        return 1
    fi
    return 0
}


pivas_vless_rollback_slot() {
#-------------------------------------------------------------------------------
#   Откат только указанного слота из per-slot snapshot (создаётся при set-N).
#   Использование: pivas_vless_rollback_slot <slot>
#-------------------------------------------------------------------------------
    local slot="$1"
    case "$slot" in 1|2) ;; *) error "Укажите слот 1 или 2"; return 1 ;; esac
    local snap
    snap=$(eval echo \$VLESS_BACKUP_SLOT${slot})
    [ -f "$snap" ] || { error "Нет бэкапа для slot-${slot} ($snap)"; return 1; }

    # snap содержит { "outbound": { tag:"slot-N", ... } }
    local _tmp
    _tmp=$(mktemp) || return 1
    jq --slurpfile snap "$snap" --arg tag "slot-${slot}" '
        .outbounds |= map(
            if .tag == $tag then ($snap[0].outbound | .tag = $tag) else . end
        )
    ' "$VLESS_CONFIG_FILE" > "$_tmp" || { rm -f "$_tmp"; return 1; }
    mv "$_tmp" "$VLESS_CONFIG_FILE"

    ready "Откат slot-${slot}, перезапуск xray"
    _kill_xray_zombies
    _rotate_xray_logs
    if _vless_restart_xray >/dev/null 2>&1; then
        _ensure_t2s_route
        _vless_sync_dns_country || return 1
        when_ok "УСПЕШНО"
    else
        when_bad "ОШИБКА"
        return 1
    fi
}


_pivas_vless_show_slot() {
    /opt/bin/python3 /opt/apps/pivas/bin/main/vless_url.py show "$VLESS_CONFIG_FILE" "$1"
}


pivas_vless_show() {
#-------------------------------------------------------------------------------
#   Показывает оба слота и списки доменов, привязанных к каждому.
#-------------------------------------------------------------------------------

    [ -f "$VLESS_CONFIG_FILE" ] || {
        error "Конфиг $VLESS_CONFIG_FILE не найден. Выполните: pivas vless set-1 <url>"
        return 1
    }

    _pivas_vless_show_slot 1
    echo
    _pivas_vless_show_slot 2
    echo

    # Slot-1: всё что в pivas.list, но не помечено на slot-2
    local _all _slot2 _only1 n1 n2 n_only1
    _all=$(mktemp); _slot2=$(mktemp); _only1=$(mktemp)
    (grep -v '^#' "${PIVAS_LIST_FILE:-/opt/etc/pivas.list}" 2>/dev/null \
        | grep -v '^[[:space:]]*$' | sort -u) > "$_all"
    if [ -s "$VLESS_SLOT2_DOMAINS_FILE" ]; then
        (grep -v '^#' "$VLESS_SLOT2_DOMAINS_FILE" | grep -v '^[[:space:]]*$' | sort -u) > "$_slot2"
    else
        : > "$_slot2"
    fi
    if [ -s "$_slot2" ] && [ -s "$_all" ]; then
        grep -vFxf "$_slot2" "$_all" > "$_only1"
    else
        cp "$_all" "$_only1"
    fi
    n1=$(wc -l < "$_all")
    n2=$(wc -l < "$_slot2")
    n_only1=$(wc -l < "$_only1")

    echo -e "${BLUE}Slot-1 домены (${n_only1}):${NOCL}"
    if [ "$n_only1" -gt 0 ]; then
        sed 's/^/  /' "$_only1"
    else
        echo "  (пусто)"
    fi
    echo

    echo -e "${BLUE}Slot-2 домены (${n2}, помимо бота):${NOCL}"
    if [ "$n2" -gt 0 ]; then
        sed 's/^/  /' "$_slot2"
    else
        echo "  (пусто — только бот идёт через slot-2)"
    fi
    echo "  Всего в pivas-списке: ${n1}."

    rm -f "$_all" "$_slot2" "$_only1"
}


pivas_vless_rollback() {
#-------------------------------------------------------------------------------
#   Восстанавливает pivas.json из последнего бэкапа (затрагивает оба слота
#   и routing, так как бэкап целиком заменяет файл).
#-------------------------------------------------------------------------------

    [ -f "$VLESS_CONFIG_FILE_BACKUP" ] || {
        error "Бэкап $VLESS_CONFIG_FILE_BACKUP не найден"
        return 1
    }
    cp "$VLESS_CONFIG_FILE_BACKUP" "$VLESS_CONFIG_FILE" || return 1
    ready "Откат конфига, перезапуск xray"
    _kill_xray_zombies
    _rotate_xray_logs
    if _vless_restart_xray >/dev/null 2>&1; then
        _ensure_t2s_route
        _vless_sync_dns_country || return 1
        when_ok "УСПЕШНО"
    else
        when_bad "ОШИБКА"
        return 1
    fi
}


_vless_pivas_list_append() {
#-------------------------------------------------------------------------------
#   Дописать домен/IP в pivas.list БЕЗ перезапуска dnsmasq (reset=no):
#   вызывающий делает один cmd_pivas_refresh_lists на весь batch.
#   Возвращает 0, если домен реально оказался в списке.
#-------------------------------------------------------------------------------
    local d="$1"
    local KLIST="${PIVAS_LIST_FILE:-/opt/etc/pivas.list}"
    # host_add напрямую: cmd_add_one_host может задать вопрос про теги
    # (read_ynq) и без tty молча выйти, не добавив домен. Валидация и
    # проверка дублей уже сделаны в pivas_vless_slot_add.
    host_add "$d" no yes </dev/null >/dev/null 2>&1
    grep -qxF "$d" "$KLIST" 2>/dev/null
}


_vless_pivas_list_remove() {
#-------------------------------------------------------------------------------
#   Убрать точную строку домена из pivas.list (и adguard-списка) без refresh.
#-------------------------------------------------------------------------------
    local d="$1" _tmp
    local KLIST="${PIVAS_LIST_FILE:-/opt/etc/pivas.list}"
    _tmp=$(mktemp) || return 1
    grep -vxF "$d" "$KLIST" > "$_tmp"; cat "$_tmp" > "$KLIST"; rm -f "$_tmp"
    if [ -n "${ADGUARD_IPSET_FILE:-}" ] && [ -f "${ADGUARD_IPSET_FILE}" ]; then
        _tmp=$(mktemp) && { grep -vF "$d" "$ADGUARD_IPSET_FILE" > "$_tmp"; cat "$_tmp" > "$ADGUARD_IPSET_FILE"; rm -f "$_tmp"; }
    fi
    return 0
}


_vless_ipset_drop_domain() {
#-------------------------------------------------------------------------------
#   Убрать из ipset IP домена/подсети, который только что удалили из списка.
#-------------------------------------------------------------------------------
    local d="$1" ip
    if printf '%s' "$d" | grep -qE -- "$(get_regexp_ip_or_range)"; then
        /opt/sbin/ipset -exist del "${IPSET_TABLE_NAME}" "$d" 2>/dev/null
        return 0
    fi
    for ip in $(dns__get_ips_by_domain "$d" 2>/dev/null); do
        /opt/sbin/ipset -exist del "${IPSET_TABLE_NAME}" "$ip" 2>/dev/null
    done
    return 0
}


pivas_vless_slot_add() {
#-------------------------------------------------------------------------------
#   Привязка одного или НЕСКОЛЬКИХ доменов к слоту. Dedup + batch.
#   Использование:  pivas_vless_slot_add <slot> <domain1> [domain2 ...]
#
#   - Если домен уже в целевом слоте → «уже в slot-X», не дёргаем pivas add.
#   - Если домен в противоположном (slot-2) — просим сначала 2-del.
#   - Для slot-2 routing-sync и xray-restart выполняются ОДИН раз в конце,
#     а не после каждого домена (важно для batch-импорта списками).
#-------------------------------------------------------------------------------
    local slot="$1"; shift
    case "$slot" in 1|2) ;; *) error "Укажите слот 1 или 2"; return 1 ;; esac
    [ $# -eq 0 ] && { echo "Использование: pivas vless ${slot}-add <domain> [<domain2> ...]"; return 1; }

    local KLIST="${PIVAS_LIST_FILE:-/opt/etc/pivas.list}"
    local S2FILE="$VLESS_SLOT2_DOMAINS_FILE"
    mkdir -p "$(dirname "$S2FILE")" 2>/dev/null
    touch "$S2FILE"
    _vless_slot2_compact "$S2FILE"

    local any_slot2_change=0
    local n_ok=0 n_dup=0 n_move=0 n_fail=0
    local raw domain in_main in_s2
    # Домены, реально дописанные в pivas.list: dnsmasq/ipset обновляем ОДИН раз
    # в конце (а не 3 с на каждый домен), прогрев DNS — в фоне.
    local added_list=""

    for raw in "$@"; do
        # Нормализация: CIDR/IP сохраняем как есть; у домена убираем схему, путь, www., пробелы.
        if printf '%s' "$raw" | grep -Eq '^[[:space:]]*[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?[[:space:]]*$'; then
            domain=$(printf '%s' "$raw" | sed 's|[[:space:]]||g')
        else
            domain=$(printf '%s' "$raw" | sed 's|^https\?://||; s|/.*$||; s|[[:space:]]||g; s|^www\.||')
        fi
        case "$domain" in
            '') continue ;;
            *.*) ;;
            *)   echo "  $raw: не похоже на домен, пропуск"; n_fail=$((n_fail+1)); continue ;;
        esac
        # Домены в списках всегда в нижнем регистре — иначе ip-api.com и
        # IP-API.com считаются разными и UI даёт добавить дважды.
        domain=$(printf '%s' "$domain" | tr '[:upper:]' '[:lower:]')

        in_main=no; in_s2=no
        grep -qxFi "$domain" "$KLIST"  2>/dev/null && in_main=yes
        grep -qxFi "$domain" "$S2FILE" 2>/dev/null && in_s2=yes

        if [ "$slot" = "1" ]; then
            if [ "$in_s2" = yes ]; then
                # Перемещаем: убираем из slot-2 override (domain остаётся в pivas-списке → пойдёт через slot-1)
                local _tmp
                _tmp=$(mktemp); grep -vxF "$domain" "$S2FILE" > "$_tmp"; mv "$_tmp" "$S2FILE"  # grep -v на последнем домене даёт rc=1 — mv без &&
                echo "  $domain: перенесён из slot-2 в slot-1"
                n_move=$((n_move+1))
                any_slot2_change=1
                continue
            fi
            if [ "$in_main" = yes ]; then
                echo "  $domain: уже в slot-1"
                n_dup=$((n_dup+1)); continue
            fi
            if _vless_pivas_list_append "$domain"; then
                echo "  $domain: добавлен в slot-1"
                n_ok=$((n_ok+1)); added_list="${added_list} ${domain}"
            else
                echo "  $domain: НЕ добавлен (проверьте dnsmasq/pivas setup)"
                n_fail=$((n_fail+1))
            fi
            continue
        fi

        # slot=2
        if [ "$in_s2" = yes ]; then
            echo "  $domain: уже в slot-2"
            n_dup=$((n_dup+1)); continue
        fi
        if [ "$in_main" = no ]; then
            if ! _vless_pivas_list_append "$domain"; then
                echo "  $domain: НЕ удалось добавить в pivas-список"
                n_fail=$((n_fail+1)); continue
            fi
            echo "  $domain: добавлен в slot-2"
            n_ok=$((n_ok+1)); added_list="${added_list} ${domain}"
        else
            echo "  $domain: перенесён из slot-1 в slot-2"
            n_move=$((n_move+1))
        fi
        echo "$domain" >> "$S2FILE"
        any_slot2_change=1
    done

    _vless_slot2_compact
    [ "$n_fail" -eq 0 ] || return 1

    if [ -n "$added_list" ]; then
        # один общий refresh: dnsmasq (ipset=/…/ таблица), IP из списка, servers-file, маршрут
        cmd_pivas_refresh_lists || return 1
        # прогрев DNS добавленных доменов — в фоне, чтобы не держать бота/веб
        ( unset PIVAS_LOCK_TOKEN PIVAS_LOCK_ENTRY; sleep 2; for _d in $added_list; do ipset__fill_by_domain "$_d"; done ) >/dev/null 2>&1 &
    fi

    if [ "$any_slot2_change" = "1" ]; then
        /opt/apps/pivas/bin/main/dnscrypt_pin dnsmasq || return 1
    fi
    # pivas add внутри 1-add/2-add зовёт cmd_pivas_init и может снести
    # table 1001. Всегда возвращаем маршрут, даже если xray не трогали.
    _ensure_t2s_route

    echo
    echo "Итого: добавлено=$n_ok, уже_было=$n_dup, перенесено_в_slot2=$n_move, ошибок=$n_fail"
    [ "$n_fail" -eq 0 ]
}


pivas_vless_slot_del() {
#-------------------------------------------------------------------------------
#   Удаление одного/нескольких доменов. Симметрично для slot-1 и slot-2:
#   домен УБИРАЕТСЯ ИЗ VPN ПОЛНОСТЬЮ (состояние «нигде» — идёт напрямую).
#
#   Если домен был в slot-2 — чистим и slot-2-override, и основной pivas-список.
#   Если домен был в slot-1 — чистим только основной (в slot-2 его не было).
#
#   Аргумент slot сейчас не меняет поведение, но оставлен для симметрии CLI
#   и для возможности warn'а если пользователь ошибся слотом.
#-------------------------------------------------------------------------------
    local slot="$1"; shift
    case "$slot" in 1|2) ;; *) error "Укажите слот 1 или 2"; return 1 ;; esac
    [ $# -eq 0 ] && { echo "Использование: pivas vless ${slot}-del <domain> [<domain2> ...]"; return 1; }

    local KLIST="${PIVAS_LIST_FILE:-/opt/etc/pivas.list}"
    local S2FILE="$VLESS_SLOT2_DOMAINS_FILE"
    local n_ok=0 n_miss=0 any_slot2_change=0
    local raw domain in_main in_s2
    local removed_list=""

    for raw in "$@"; do
        if printf '%s' "$raw" | grep -Eq '^[[:space:]]*[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?[[:space:]]*$'; then
            domain=$(printf '%s' "$raw" | sed 's|[[:space:]]||g')
        else
            domain=$(printf '%s' "$raw" | sed 's|^https\?://||; s|/.*$||; s|[[:space:]]||g; s|^www\.||' | tr '[:upper:]' '[:lower:]')
        fi
        [ -z "$domain" ] && continue

        in_main=no; in_s2=no
        grep -qxF "$domain" "$KLIST"  2>/dev/null && in_main=yes
        grep -qxF "$domain" "$S2FILE" 2>/dev/null && in_s2=yes

        if [ "$in_main" = "no" ] && [ "$in_s2" = "no" ]; then
            echo "  $domain: не было в списках"
            n_miss=$((n_miss+1))
            continue
        fi

        # Если был в slot-2 — сначала snapshot slot-2 override
        if [ "$in_s2" = "yes" ]; then
            local _tmp
            _tmp=$(mktemp); grep -vxF "$domain" "$S2FILE" > "$_tmp"; mv "$_tmp" "$S2FILE"  # grep -v на последнем домене даёт rc=1 — mv без &&
            any_slot2_change=1
        fi

        # Теперь вычищаем из основного pivas-списка (без refresh — он один в конце)
        if [ "$in_main" = "yes" ]; then
            _vless_pivas_list_remove "$domain"
            removed_list="${removed_list} ${domain}"
        fi

        # Для понятности сообщения — какой из слотов это был
        if [ "$in_s2" = "yes" ]; then
            echo "  $domain: удалён (был в slot-2)"
        else
            echo "  $domain: удалён (был в slot-1)"
        fi
        n_ok=$((n_ok+1))
    done

    if [ -n "$removed_list" ]; then
        # один общий refresh dnsmasq/ipset/servers-file на весь batch
        cmd_pivas_refresh_lists || return 1
        # IP удалённых доменов вычищаем из ipset в фоне (dig на каждый — медленно)
        ( unset PIVAS_LOCK_TOKEN PIVAS_LOCK_ENTRY; for _d in $removed_list; do _vless_ipset_drop_domain "$_d"; done ) >/dev/null 2>&1 &
    fi

    # Если тронули slot-2 override — compact, sync routing и restart xray один раз
    _vless_slot2_compact "$S2FILE"
    if [ "$any_slot2_change" = "1" ]; then
        /opt/apps/pivas/bin/main/dnscrypt_pin dnsmasq || return 1
    fi
    # pivas del → cmd_pivas_init может снести table 1001
    _ensure_t2s_route

    echo
    echo "Итого: удалено=$n_ok, не_было=$n_miss"
}


pivas_vless_slot_list() {
#-------------------------------------------------------------------------------
#   Показывает список доменов, эффективно привязанных к слоту.
#   slot=1: основной pivas-список МИНУС overrides из slot-2.
#   slot=2: содержимое slot-2 override-файла.
#-------------------------------------------------------------------------------
    local slot="$1"
    case "$slot" in 1|2) ;; *) error "Укажите слот 1 или 2"; return 1 ;; esac
    if [ "$slot" = "1" ]; then
        echo -e "${GREEN}Slot-1 домены (трафик идёт через slot-1):${NOCL}"
        local _all _slot2 _tmp
        _all=$(mktemp) || return 1
        _slot2=$(mktemp) || { rm -f "$_all"; return 1; }
        # Чистый pivas-список (без цветных кодов/пустых строк); как есть
        pivas show 2>/dev/null \
            | sed -E 's/\x1B\[[0-9;]*[A-Za-z]//g' \
            | grep -vE '^[[:space:]]*$|^-+$|Итого|защищ' \
            | awk '{ print $1 }' \
            | sort -u > "$_all"
        if [ -s "$VLESS_SLOT2_DOMAINS_FILE" ]; then
            grep -v '^#' "$VLESS_SLOT2_DOMAINS_FILE" \
                | grep -vE '^[[:space:]]*$' | sort -u > "$_slot2"
        else
            : > "$_slot2"
        fi
        # Разность: в _all, но не в _slot2
        if [ -s "$_all" ]; then
            if [ -s "$_slot2" ]; then
                grep -vFxf "$_slot2" "$_all" | sed 's/^/  /'
            else
                sed 's/^/  /' "$_all"
            fi
            echo
            local n1 n2
            n1=$(wc -l < "$_all")
            n2=$(wc -l < "$_slot2")
            echo "  (всего в pivas-списке: $n1, из них через slot-2: $n2)"
        else
            echo "  (pivas-список пуст)"
        fi
        rm -f "$_all" "$_slot2"
        return 0
    fi
    echo -e "${GREEN}Slot-2 домены:${NOCL}"
    if [ -s "$VLESS_SLOT2_DOMAINS_FILE" ]; then
        grep -v '^#' "$VLESS_SLOT2_DOMAINS_FILE" | grep -v '^[[:space:]]*$' \
            | tr '[:upper:]' '[:lower:]' | sort -u | sed 's/^/  /'
    else
        echo "  (пусто — только трафик бота идёт через slot-2)"
    fi
}

_vless_slot2_compact() {
#-------------------------------------------------------------------------------
#   Убрать дубли и пустые строки из pivas-slot2.list (нижний регистр).
#-------------------------------------------------------------------------------
    local f="${1:-$VLESS_SLOT2_DOMAINS_FILE}"
    [ -f "$f" ] || return 0
    local tmp
    tmp=$(mktemp) || return 1
    grep -v '^#' "$f" 2>/dev/null | grep -v '^[[:space:]]*$' \
        | sed 's/[[:space:]]//g' | tr '[:upper:]' '[:lower:]' | sort -u > "$tmp"
    mv "$tmp" "$f"
    if [ -x /opt/apps/pivas/bin/main/dnscrypt_pin ]; then
        /opt/apps/pivas/bin/main/dnscrypt_pin dnsmasq >/dev/null 2>&1 || true
    fi
}



set_cursor_to_line_above() {
#-------------------------------------------------------------------------------
#
#	Функция устанавливает курсор на одну строку вверх на первую позицию
#   и стираем содержимое строки выше
#
#-------------------------------------------------------------------------------
    echo -en "\033[1A\033[2K"
}



delete_proxy_interface() {
#-------------------------------------------------------------------------------
#
#	Функция удаляет Proxy интерфейс
#
#-------------------------------------------------------------------------------
    # Удаляем конфигурацию профиля Proxy перед установкой такой же конфигурации
    api_post_query  '[{"interface": { "name": "'${PROXY_VLESS_NAME}'","no": true },"system": {"configuration": {"save": true}}}]' &> /dev/null
}


cmd_install_proxy_package() {
#-------------------------------------------------------------------------------
#
#	Функция устанавливает пакет Proxy
#
#-------------------------------------------------------------------------------
    if ! has_package_installed 'Proxy client' ; then

        # Создаем запись в файле /opt/etc/profile для продолжения установки Proxy клиента
        # DEBUG - восстановить после отладки
        echo "pivas vless" >> /opt/etc/profile
        # echo "/opt/root/vless.dev" >> /opt/etc/profile

        #  Ставим пакет proxy в очередь на установку
        system_packages_action install proxy opkg-kmod-netfilter opkg-kmod-netfilter-addons && create_proxy_interface || return 1

    else

        # продолжение установки Proxy клиента

        create_proxy_interface
        

        return 0
    fi
set +xeu
}


create_proxy_interface(){
#-------------------------------------------------------------------------------
#
#   Функция для создания интерфейса для Proxy клиента и задает ему его свойства по умолчанию
#
#-------------------------------------------------------------------------------

    delete_proxy_interface

    data='[{
        "interface": {
            "name": "'${PROXY_VLESS_NAME}'",
            "description": "'${PROXY_VLESS_DESC}'",
            "proxy": {
                "protocol": {
                    "proto": "'${PROXY_VLESS_PROTO}'"
                },
                "upstream": {
                    "host": "'${PROXY_LOCAL_IP}'",
                    "port": "'${PROXY_VLESS_PORT}'"
                },
                "socks5-udp": true
            }
        },
        "system": {
            "configuration": {
                "save": true
            }
        }
    }]'

    # создаем интерфейс для Proxy клиента и задает ему его свойства по умолчанию
    api_post_query "${data}" "" &> /dev/null

    # удаляем запись в файле /opt/etc/profile, чтобы прекратить повторную установку Proxy клиента
    # DEBUG - восстановить после отладки
    sed -i '/pivas vless/d' /opt/etc/profile
    # sed -i '/\/opt\/root\/vless.dev/d' /opt/etc/profile

}

