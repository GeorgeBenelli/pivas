has_package_installed() {
#-------------------------------------------------------------------------------
#
#	Функция проверяет установлен ли пакет Proxy
#
#-------------------------------------------------------------------------------
    grep -q "<name>${1}</name>" /etc/components.xml
}

has_package_uninstalled() {
#-------------------------------------------------------------------------------
#
#       Функция проверяет установлен ли пакет Proxy
#
#-------------------------------------------------------------------------------
    ! grep -q "<name>${1}</name>" /etc/components.xml
}

has_xray_enable(){
#-------------------------------------------------------------------------------
#
#	Функция проверяет, включен ли Xray
#
#-------------------------------------------------------------------------------
    # [ -x "${XRAY}" ] && [ -f "${XRAY_INIT}" ] && [ "$("${XRAY_INIT}" status)" = 'alive' ]
    [ -f "${XRAY_INIT}" ] && [ "$("${XRAY_INIT}" status)" = 'alive' ]
}

has_proxy_inface_selected(){
#-------------------------------------------------------------------------------
#
#	Функция проверяет, является ли интерфейс Proxy Vless Pivas
#   выбранным соединением или нет
#
#-------------------------------------------------------------------------------
    proxy_entware_id=$(get_config_value INFACE_ENT)
    [ "${proxy_entware_id}" = "${PROXY_VLESS_NAME}" ]

}

api_post_query(){
#-------------------------------------------------------------------------------
#
#	Функция отправляет запросы к API Keenetic
#
#-------------------------------------------------------------------------------

	local _data=${1}
    local _query=${2:-}
	local _result

	if [ -z "${_data}" ]; then
		curl -s "localhost:79/rci/${_query}"
	else
		curl -s -d "${_data}" "localhost:79/rci/${_query}"
	fi

}

api_get_query(){
#-------------------------------------------------------------------------------
#
#	Функция отправляет запросы к API Keenetic
#
#-------------------------------------------------------------------------------

    local _query=${1}
    local _result
    curl -s "localhost:79/rci/${_query}"

}

_vless_invalid() {
#-------------------------------------------------------------------------------
#   Выводит единообразный баннер про невалидную ссылку + описание причины.
#   Без print_line — обрамление рисует вызывающая команда (pivas dispatcher).
#-------------------------------------------------------------------------------
    local reason="$1"
    echo -e "${RED}Ссылка не принята:${NOCL} ${reason}"
    echo -e "${BLUE}Ожидаемый формат:${NOCL}"
    echo "  vless://UUID@host:443?type=tcp&security=reality&pbk=...&sni=...&fp=firefox&flow=xtls-rprx-vision"
    echo "  vless://UUID@host:443?type=grpc&security=tls&sni=...&serviceName=..."
    echo "  hysteria2://password@host:443/?sni=...&obfs=salamander&obfs-password=..."
    echo "Reality требует pbk; gRPC и XHTTP требуют пустой flow."
}


#===============================================================================
#   pivas_vless_ping — проверяет живость обоих VLESS-слотов.
#
#   slot-1 → SOCKS5 127.0.0.1:1097 (трафик маршрутизируется в slot-1 outbound)
#   slot-2 → HTTP   127.0.0.1:1098 (трафик в slot-2)
#
#   Делает HTTPS-запрос на ifconfig.me через каждый прокси с таймаутом 6с,
#   печатает exit-IP и latency. Если прокси мёртв (timeout / refused) — выводит
#   причину.
#===============================================================================
pivas_vless_ping() {
    # Два измерения на слот:
    #  net — чистый TCP-connect до host:port VLESS-сервера (как Happ на iPhone)
    #  e2e — HTTPS через xray-inbound → VLESS+Reality → cp.cloudflare.com/204
    local TARGET="https://cp.cloudflare.com/generate_204"
    local CONNECT_TO=4 TOTAL_TO=6
    print_line
    echo -e "${GREEN}Проверка слотов${NOCL}"
    echo -e "  ${BLUE}net${NOCL} — TCP-ping до сервера (как Happ)"
    echo -e "  ${BLUE}e2e${NOCL} — HTTPS через Xray (полный путь); Hysteria 2 использует QUIC"
    print_line

    _get_hostport() {
        [ -f /opt/etc/xray/pivas.json ] || return
        jq -r --arg tag "slot-$1" \
            '.outbounds[] | select(.tag==$tag) | (if .protocol=="hysteria" then .settings else .settings.vnext[0] end) | (if (.address//""|contains(":")) then "["+.address+"]" else (.address//"") end) + ":" + (.port|tostring)' \
            /opt/etc/xray/pivas.json 2>/dev/null
    }

    _net_ms() {
        local hostport=$1 host port t
        [ -z "$hostport" ] || [ "$hostport" = ":" ] && { echo "—"; return; }
        host=${hostport%:*}
        port=${hostport##*:}
        t=$(curl -s -k -o /dev/null \
              --connect-timeout "$CONNECT_TO" --max-time "$CONNECT_TO" \
              -w '%{time_connect}' "https://${host}:${port}/" 2>/dev/null)
        awk -v t="$t" 'BEGIN{if(t+0==0){print "timeout"}else{printf "%dмс", t*1000}}'
    }

    _probe_slot() {
        local slot=$1 proxy=$2 hostport net out rc code ttot e2e
        hostport=$(_get_hostport "$slot")
        if jq -e --arg tag "slot-$slot" '.outbounds[] | select(.tag==$tag) | .protocol=="hysteria"' "$VLESS_CONFIG_FILE" >/dev/null 2>&1; then
            net="QUIC"
        else
            net=$(_net_ms "$hostport")
        fi

        out=$(curl -s -x "$proxy" --max-time "$TOTAL_TO" \
              -w '\n__meta__ %{http_code} %{time_total}' "$TARGET" 2>/dev/null)
        rc=$?
        if [ $rc -eq 0 ]; then
            code=$(printf '%s\n' "$out" | awk '/^__meta__/ {print $2; exit}')
            ttot=$(printf '%s\n' "$out" | awk '/^__meta__/ {print $3; exit}')
            e2e=$(awk -v t="$ttot" 'BEGIN{printf "%d", t*1000}')
            if [ "$code" = "204" ] || [ "$code" = "200" ]; then
                # exit-IP отдельным быстрым запросом
                local ip
                ip=$(curl -s -x "$proxy" --max-time 4 https://ifconfig.me 2>/dev/null | tr -d '\r\n' | head -c 40)
                printf "  ${GREEN}✓${NOCL} slot-%s  %-22s  net=%-8s  e2e=%dмс\n" \
                    "$slot" "$ip" "$net" "$e2e"
                printf "     ${BLUE}└─${NOCL} сервер: %s\n" "$hostport"
                return 0
            fi
            printf "  ${RED}✗${NOCL} slot-%s  HTTP %s    net=%s  e2e=%dмс\n" \
                "$slot" "$code" "$net" "$e2e"
            return 1
        fi
        local err
        case $rc in
            28) err="timeout ${TOTAL_TO}s" ;;
            7)  err="xray-прокси не отвечает" ;;
            *)  err="curl rc=$rc" ;;
        esac
        printf "  ${RED}✗${NOCL} slot-%s  %-22s  net=%-8s  e2e=—\n" "$slot" "$err" "$net"
        [ -n "$hostport" ] && printf "     ${BLUE}└─${NOCL} сервер: %s\n" "$hostport"
        return 1
    }

    _probe_slot 1 "socks5h://127.0.0.1:1097"
    _probe_slot 2 "http://127.0.0.1:1098"
    print_line
}


