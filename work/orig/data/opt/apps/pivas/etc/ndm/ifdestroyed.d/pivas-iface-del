#!/bin/sh

# All state writers share one lock; nested calls retain its owner token.
if [ "${PIVAS_LOCK_ENTRY:-}" != "$0" ]; then
    exec /opt/bin/python3 /opt/apps/pivas/bin/main/runtime.py try-locked "$0" "$@"
fi
unset PIVAS_LOCK_ENTRY

# ------------------------------------------------------------------------------------------
#
# 	ПРОЕКТ ПИВАС
#
# ------------------------------------------------------------------------------------------
# 	Данный файл служит основной библиотекой функций пакета ПИВАС
# ------------------------------------------------------------------------------------------
#	Дата: 18/01/2024
#	Лицензия: Apache License 2.0
# ------------------------------------------------------------------------------------------

if [ "${1}" = "hook" ] ; then

	# Подключаем библиотеку ndm_d
	. /opt/apps/pivas/bin/libs/ndm_d

	#	В случае, если созданное подключение уже есть т в списке интерфейсов,
	#	то удаляем его из файла  /opt/etc/inface_equals

    grep -q "${id}" "${iface_file}" && sed -i '/'"${id}"'/d' "${iface_file}"

fi
