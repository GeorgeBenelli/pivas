_vless_dns_probe() {
#-------------------------------------------------------------------------------
#   Один DNS-запрос к локальному резолверу. $1 - порт, $2 - домен.
#   Успех = получен ответ NOERROR с хотя бы одной A-записью.
#   dig (bind-dig) - зависимость пакета; если его нет - считаем, что проверить
#   нечем и не мешаем работе (возврат 0).
#-------------------------------------------------------------------------------
    local port="$1" host="${2:-${DOMAIN_FOR_CHECK}}" out
    command -v dig >/dev/null 2>&1 || return 0
    out=$(dig +time=2 +tries=1 +short @127.0.0.1 -p "${port}" "${host}" A 2>/dev/null)
    echo "${out}" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}$'
}


_vless_dns_selfcheck() {
    [ -f /opt/etc/pivas.paused ] && return 0
#-------------------------------------------------------------------------------
#   Проверка DNS-цепочки после смены VLESS-ссылки.
#
#   ВАЖНО: смена outbound в xray НЕ должна трогать DNS. Весь DNS домашней сети
#   жёстко заворачивается DNAT'ом в dnsmasq:9753 -> dnscrypt-proxy:9153, без
#   запасного пути. Раньше здесь рестартовали dnsmasq и dnscrypt-proxy2, делали
#   flush PIVAS_LIST и пересобирали маршруты - любая заминка при старте
#   (dnscrypt-proxy без живых серверов, порт ещё занят, гонка с ndm-хуками)
#   превращалась в полную потерю DNS у всех клиентов, которая сама не проходила.
#
#   Теперь ничего не перезапускаем. Только смотрим, отвечает ли локальный
#   резолвер, и если служба лежит - поднимаем её командой start (не restart:
#   живой процесс не трогаем). Постоянно за DNS следит сторожок в
#   /opt/apps/pivas/bin/main/check_vpn (cron каждые 5 минут).
#-------------------------------------------------------------------------------
    local dns_port

    if [ -x /opt/etc/init.d/S99adguardhome ] && ! [ -f /opt/etc/init.d/S56dnsmasq ]; then
        ready "Проверяем DNS (AdGuard Home)"
        if /opt/etc/init.d/S99adguardhome status 2>/dev/null | grep -q alive; then
            when_ok "РАБОТАЕТ"
        else
            /opt/etc/init.d/S99adguardhome start >/dev/null 2>&1
            sleep 2
            /opt/etc/init.d/S99adguardhome status 2>/dev/null | grep -q alive \
                && when_alert "ПОДНЯТ" || when_bad "ЛЕЖИТ"
        fi
        return 0
    fi

    [ -f /opt/etc/init.d/S56dnsmasq ] || return 0

    dns_port=$(get_config_value DNSMASQ_PORT)
    [ -n "${dns_port}" ] || dns_port=9753

    ready "Проверяем DNS (dnsmasq:${dns_port})"
    if _vless_dns_probe "${dns_port}"; then
        when_ok "ОТВЕЧАЕТ"
        return 0
    fi

    # Не отвечает: сначала поднимаем то, что лежит. start у rc.func идемпотентен
    # ("already running"), поэтому живые процессы не пострадают.
    if ! /opt/etc/init.d/S56dnsmasq status 2>/dev/null | grep -q alive; then
        /opt/etc/init.d/S56dnsmasq start >/dev/null 2>&1
    fi
    if [ -x /opt/etc/init.d/S09dnscrypt-proxy2 ] && \
       ! /opt/etc/init.d/S09dnscrypt-proxy2 status 2>/dev/null | grep -q alive; then
        /opt/etc/init.d/S09dnscrypt-proxy2 start >/dev/null 2>&1
    fi
    sleep 3

    if _vless_dns_probe "${dns_port}"; then
        when_alert "ПОДНЯТ"
        logger -t "ПИВАС" "vless set: локальный DNS не отвечал, службы подняты"
        return 0
    fi

    when_bad "НЕ ОТВЕЧАЕТ"
    logger -t "ПИВАС" "vless set: локальный DNS (127.0.0.1:${dns_port}) не отвечает"
    warning "DNS домашней сети завёрнут в dnsmasq:${dns_port}. Проверьте: pivas status / pivas debug."
    if [ -x /opt/etc/init.d/S09dnscrypt-proxy2 ] && ! _vless_dns_probe "$(get_config_value DNS_CRYPT_PORT)"; then
        warning "dnscrypt-proxy2 не резолвит: нет живых DNSCrypt-серверов или закрыт исходящий DNS."
    fi
    return 1
}


